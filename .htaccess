# =================================================================
# .htaccess — TechNewsZone
# =================================================================

# --- Canonicalizzazione: forza HTTPS e dominio con www ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) http -> https
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2) senza www -> con www (dopo aver già forzato https)
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Blocca l'accesso diretto ai file di dati e configurazione ---
# (le pagine PHP li leggono via filesystem, non serve che siano
# raggiungibili direttamente da browser)
<FilesMatch "\.(json|csv|dat|md|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# manifest.json deve restare pubblico: serve alla PWA
<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# File di configurazione sensibili: mai serviti come testo, anche in caso
# di misconfigurazione del motore PHP sul server
<FilesMatch "^(config|push_config|admin_auth|admin_auth_config)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# File nascosti (.htaccess, .htpasswd, .git, .env, ...)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Vieta il listing delle directory
Options -Indexes

# --- Header di sicurezza ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Compressione ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/rss+xml application/xml
</IfModule>

# --- Cache lato browser per gli asset statici ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>
